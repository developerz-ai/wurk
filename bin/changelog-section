#!/usr/bin/env ruby
# frozen_string_literal: true

# Print a release's notes body, used by the release workflow to populate the
# GitHub Release notes. Pass the RubyGems version (dot-form, e.g. "1.0.0" or
# "1.0.0.rc1"); it names the file docs/changelog/<version>.md, whose
# `# <version> — <date>` title line is dropped. Exits non-zero with a clear
# message if the file is absent or has no body.
#
#   bin/changelog-section 1.0.0

version = ARGV[0].to_s
abort 'usage: bin/changelog-section <version>' unless version.match?(/\A\d+(?:\.[0-9A-Za-z]+)*\z/)

root = File.expand_path('..', __dir__)
rel = "docs/changelog/#{version}.md"
path = File.join(root, rel)
unless File.file?(path)
  abort "changelog-section ✗ no #{rel} (cutting a release moves docs/changelog/unreleased.md there)"
end

body = File.read(path).sub(/\A# [^\n]*\n/, '').strip
abort "changelog-section ✗ #{rel} has no notes under its title" if body.empty?

puts body
