#!/usr/bin/env bash
# The one command to run before opening a PR: the same gates CI runs, in the
# order that fails fastest.
#
#   bin/check              lint + frontend + full suite + parity  (the PR gate)
#   bin/check fast         lint + unit tests only                  (the inner loop)
#   bin/check full         everything above + ecosystem            (third-party suites)
#
# Anything it runs, CI runs too — so a green `bin/check` is the same answer the
# PR will get.
#
# Env knobs:
#   NCPU=<n>   parallel test workers (default: core count, capped at 14)
#   SKIP_LINT=1 / SKIP_PARITY=1 / SKIP_FRONTEND=1   drop a stage
set -euo pipefail

cd "$(dirname "$0")/.."

MODE="${1:-}"
case "$MODE" in
  ''|pr) MODE=pr ;;
  fast|full) ;;
  -h|--help|help)
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    echo "bin/check: unknown mode '$MODE' (want: fast | pr | full)" >&2
    exit 64
    ;;
esac

start=$(date +%s)
failed=()

# Each stage reports its own wall clock: the point of this script is to make the
# slow stage obvious, so someone can reach for `bin/check fast` on the inner
# loop instead of paying for the whole gate on every save.
stage() {
  local name="$1"
  shift
  local t0
  t0=$(date +%s)
  echo
  echo "==> ${name}"
  if "$@"; then
    echo "    ✓ ${name} ($(($(date +%s) - t0))s)"
  else
    echo "    ✗ ${name} ($(($(date +%s) - t0))s)"
    failed+=("$name")
  fi
}

# Bundler is not optional either, and its absence is NOT a verdict on a diff.
# Every stage below is `bundle exec`, and `stage()` runs its command inside an
# `if`, so a missing bundler does not abort under `set -e`: the shell's 127 is
# swallowed into `failed[]` and this script exits 1. Exit 1 means "the gate ran
# and judged the change", so an environment with no Ruby toolchain would tell a
# coding agent its edit is RED and send it hunting a bug it did not write
# (developerz-ai/developerz.ai#3067). Refuse with 75 instead — the same
# preconditions-unmet contract the Redis guard below uses.
if ! command -v bundle >/dev/null 2>&1; then
  echo "bin/check: no bundler on PATH — this environment cannot run the Ruby gate." >&2
  echo "  install Ruby and bundler, then:  bundle install" >&2
  exit 75
fi

# Bundler ON PATH is not the same as the bundle being INSTALLED, and the gap
# between them is the third way this gate can report a verdict it never reached.
# A box that has ruby and bundler but has never run `bin/setup` fails every
# `bundle exec` stage below with "Could not find gem ..." — swallowed into
# `failed[]` exactly like the 127 above, and exiting 1: "the gate ran and judged
# the change". It did not. Same laundering as the two guards either side of this
# one, one layer further in.
#
# `bundle check` is the probe `bin/setup:18` already trusts for this exact
# question (`bundle check >/dev/null 2>&1 || bundle install`), so this adds no
# new technique and no new dependency — it asks the question the setup script
# asks, at the moment the gate needs the answer.
if ! bundle check >/dev/null 2>&1; then
  echo "bin/check: gems are not installed — this environment cannot run the Ruby gate." >&2
  echo "  run bin/setup first, or:  bundle install" >&2
  exit 75
fi

# Redis is not optional — integration and parity tests use a real server, never
# a mock (CLAUDE.md). Refuse with the platform's preconditions-unmet contract
# code (apps/runner/src/modes/setup/base.ts, CHECK_EXIT_PRECONDITIONS_UNMET =
# 75). Local developers who hit this need a Redis on 127.0.0.1:6379 — the two
# lines on stderr above tell them how. `docker run --rm -p 6379:6379 redis:7.4`
# is the supported path.
if ! (exec 3<>/dev/tcp/127.0.0.1/6379) 2>/dev/null; then
  echo "bin/check: no Redis on 127.0.0.1:6379." >&2
  echo "  start one with:  docker run --rm -p 6379:6379 redis:7.4" >&2
  exit 75
fi

[ -n "${SKIP_LINT:-}" ] || stage "rubocop" bundle exec rubocop --parallel

# Frontend gate mirrors test.yml's `frontend (vitest)` job: bun install +
# typecheck + oxlint + vitest in frontend/. CI runs each as its own step;
# bin/check rolls them into one stage so a failing step stops the gate fast
# and the wall-clock report stays short. Skipped in `fast` (the inner loop is
# the Ruby edit cycle, not dashboard work) and via SKIP_FRONTEND=1. Without
# bun on PATH, refuse with 75 — the same preconditions-unmet code the
# bundler / Redis guards above use.
run_frontend_stage() {
  (
    cd frontend
    bun install --frozen-lockfile \
      && bun run typecheck \
      && bun run lint \
      && bun run test
  )
}

if [ "$MODE" != fast ] && [ -z "${SKIP_FRONTEND:-}" ]; then
  if ! command -v bun >/dev/null 2>&1; then
    echo "bin/check: no bun on PATH — frontend gate cannot execute." >&2
    echo "  install bun:                    curl -fsSL https://bun.sh/install | bash" >&2
    exit 75
  fi
  stage "frontend" run_frontend_stage
fi

case "$MODE" in
  fast) stage "unit tests" bundle exec rake test:unit ;;
  *)    stage "test suite (unit + integration + engine)" bundle exec rake test ;;
esac

if [ "$MODE" != fast ] && [ -z "${SKIP_PARITY:-}" ]; then
  stage "parity oracles" bundle exec rake test:parity
fi

[ "$MODE" = full ] && stage "ecosystem suites" bundle exec rake test:ecosystem

# The reference Python client. Two separate questions, and only one of them
# needs pip: the tests import the client from `clients/python/src` via
# `sys.path` (tests/test_client.py:15), so they run against a bare python3 with
# nothing installed. Run them first and unconditionally — that is the
# regression gate.
#
# `python3 -m pip install ./clients/python` answers the other question ("does
# the package still build?") and must never be run against the active
# interpreter: it mutates whatever environment the developer is in, and on a
# PEP-668 box it does not even work. `command -v python3` does not imply a
# usable pip, and the gap between them is the same false-verdict laundering the
# bundler and redis guards above exist to prevent — a red `python-client build`
# would tell an agent its diff broke something when the box is simply missing a
# package. Measured on ovh-1b: python3 3.14.4 on PATH, `python3 -m pip` reports
# "No module named pip", the stdlib carries EXTERNALLY-MANAGED, and
# `python3 -m venv` produces a venv with no pip at all because python3-venv is
# not installed. So: build in a throwaway venv, and when that venv cannot
# bootstrap pip, say so and skip rather than fail.
python_client_build() {
  local venv rc=0
  venv=$(mktemp -d)
  python3 -m venv "$venv/v" >/dev/null 2>&1 || true
  if [ -x "$venv/v/bin/python" ] && "$venv/v/bin/python" -m pip --version >/dev/null 2>&1; then
    "$venv/v/bin/python" -m pip install --quiet ./clients/python || rc=$?
  else
    echo "    – skipped: python3 -m venv cannot bootstrap pip (install python3-venv)"
  fi
  rm -rf "$venv"
  return "$rc"
}

if [ "$MODE" = full ]; then
  if command -v python3 >/dev/null 2>&1; then
    stage "python-client tests" python3 -m unittest discover -s clients/python/tests -v
    stage "python-client build (isolated venv)" python_client_build
  else
    echo
    echo "==> python-client skipped: python3 not found"
  fi
fi

echo
if [ ${#failed[@]} -eq 0 ]; then
  echo "bin/check ✓ all green in $(($(date +%s) - start))s"
  exit 0
fi

echo "bin/check ✗ failed: ${failed[*]}  ($(($(date +%s) - start))s)" >&2
exit 1
