#!/usr/bin/env bash
# Usage: bin/ci-dup-push [workflow path, default .github/workflows/test.yml]
# Prints `true` only when this push to main re-tests a tree that a green
# run of that workflow already covered on the merged PR's head; otherwise `false`.
# A squash merge of an up-to-date PR lands a byte-identical tree, so the
# push run would repeat the PR run exactly — the gated jobs skip instead.
#
# Every failure path prints `false` (run everything): a wrong `true` would
# skip the only gate a direct push to main ever gets. `set -e` is deliberately
# NOT used. Needs `gh` (preinstalled on GitHub runners) and GH_TOKEN.
set -uo pipefail

workflow="${1:-.github/workflows/test.yml}"

no() { echo "ci-dup-push: $1 — full run" >&2; echo false; exit 0; }

[ "${GITHUB_EVENT_NAME:-}" = "push" ] || no "event '${GITHUB_EVENT_NAME:-}' is not a push"
repo="${GITHUB_REPOSITORY:-}"
[ -n "$repo" ] || no "GITHUB_REPOSITORY is empty"
head_sha="$(git rev-parse HEAD 2>/dev/null)" || no "no HEAD sha"
head_tree="$(git rev-parse 'HEAD^{tree}' 2>/dev/null)" || no "no HEAD tree"
subject="$(git log -1 --format=%s 2>/dev/null)" || no "no subject"
[[ "$subject" =~ \(#([0-9]+)\)$ ]] || no "subject carries no trailing '(#N)'"
pr="${BASH_REMATCH[1]}"

pr_json="$(gh api "repos/$repo/pulls/$pr" 2>/dev/null)" || no "PR #$pr unreadable"
merge_sha="$(jq -r '.merge_commit_sha // empty' <<<"$pr_json")"
[ "$merge_sha" = "$head_sha" ] || no "PR #$pr merge commit '$merge_sha' is not HEAD $head_sha"
pr_head="$(jq -r '.head.sha // empty' <<<"$pr_json")"
[ -n "$pr_head" ] || no "PR #$pr has no head sha"

pr_tree="$(gh api "repos/$repo/commits/$pr_head" --jq '.commit.tree.sha' 2>/dev/null)" || no "head $pr_head unreadable"
[ "$pr_tree" = "$head_tree" ] || no "tree moved: HEAD $head_tree vs PR #$pr head $pr_tree"

# GitHub may suffix `path` with `@<ref>`; compare the file part only.
run_id="$(gh api "repos/$repo/actions/runs?head_sha=$pr_head&per_page=100" \
  --jq "[.workflow_runs[] | select((.path | split(\"@\")[0]) == \"$workflow\" and .conclusion == \"success\")][0].id // empty" 2>/dev/null)" \
  || no "run list for $pr_head unreadable"
[ -n "$run_id" ] || no "no green $workflow run on PR #$pr head $pr_head"

# A green PR run whose path-gated steps were skipped (e.g. a docs-only PR)
# proves nothing about the gates main would run. Every conditional step in
# these workflows is RUN-gated, so a run that executed every gate has zero
# skipped steps.
skipped="$(gh api "repos/$repo/actions/runs/$run_id/jobs?per_page=100" \
  --jq '[.jobs[].steps[] | select(.conclusion == "skipped")] | length' 2>/dev/null)" \
  || no "jobs for run $run_id unreadable"
[ "$skipped" = "0" ] || no "PR run $run_id skipped $skipped gated steps"

echo "ci-dup-push: tree $head_tree already passed $workflow on PR #$pr head $pr_head — skipping" >&2
echo true
