#!/usr/bin/env bash
set -euo pipefail

# Container entrypoint for the public demo. One image, two roles:
#   web    — read-only dashboard (puma) + the demo traffic producer thread.
#            WURK_DEMO_PRODUCER=1 is set HERE ONLY: the producer holds a Redis
#            connection, so it must live in a process that never forks.
#   worker — the job-processing swarm. Drains what the producer enqueues.
# Both set WURK_DISABLED=1 so the railtie never backgrounds a swarm; the worker
# runs supervise itself. Anything else (the reset CronJob's `bundle exec rails
# demo:reset`) is exec'd as-is from demo/ with neither swarm nor producer.
#
# Read-only + demo mode come from the image env (WURK_WEB_READ_ONLY=1,
# WURK_DEMO=1). Redis comes from REDIS_URL.

role="${1:-web}"
cd "$(dirname "$0")/../demo"

case "$role" in
  web)
    export WURK_DISABLED=1 WURK_DEMO_PRODUCER=1
    exec bundle exec rails server -b 0.0.0.0 -p "${PORT:-3000}"
    ;;
  worker)
    # Load the Rails app (so the demo job classes + the WURK_DEMO server
    # middleware are present) but keep the railtie from backgrounding the swarm,
    # then run supervise on the MAIN thread so SIGTERM drains and exits promptly
    # instead of being stuck in a sleep until SIGKILL.
    #
    # Without WURK_COUNT the swarm forks one child per *node* core (Etc.nprocessors
    # sees the host, not the pod's cgroup) — 6 children in a pod requesting 100m
    # CPU under a 768Mi memory limit. Two is plenty for the demo's trickle; the
    # deployment env can still override.
    export WURK_DISABLED=1 WURK_COUNT="${WURK_COUNT:-2}"
    exec bundle exec rails runner "
      swarm = Wurk::Swarm.new(topology: Wurk.configuration.topology)
      swarm.boot
      swarm.supervise
    "
    ;;
  *)
    exec "$@"
    ;;
esac
