#!/usr/bin/env bash
# Read-only health graders; preserve captured failure handling (no errexit/pipefail).
case "${1:-}" in
  main)
run=$(gh run list --workflow test.yml --branch main --event push --limit 1 --json databaseId,headSha,conclusion,url 2>/dev/null); rc=$?; if [ "$rc" -ne 0 ] || [ -z "$run" ] || ! printf '%s' "$run" | jq -e 'type == "array"' >/dev/null 2>&1; then echo "verdict unknown test.yml: the run list is not readable (gh run list failed or returned a non-array)"; elif [ "$(printf '%s' "$run" | jq -r 'length')" = "0" ]; then echo "no run: test.yml has no matching run"; else run=$(printf '%s' "$run" | jq -c '.[0]'); sha=$(jq -r .headSha <<<"$run"); url=$(jq -r .url <<<"$run"); c=$(jq -r .conclusion <<<"$run"); dbid=$(jq -r .databaseId <<<"$run"); v=$(gh api "repos/$(gh repo view --json nameWithOwner -q .nameWithOwner)/actions/runs/$dbid/jobs" | jq -r 'def gate_steps: [(.steps // [])[] | select(.name != "Set up job" and .name != "Complete job")]; [.jobs[]?] as $all | [$all[] | select(.name != "detect changed paths")] as $g | [$all[] | select(.name == "detect changed paths")] as $d | ($g | map(gate_steps)) as $gs | if ($all | length) == 0 then "evidence unavailable (the jobs list could not be read)" elif ($g | length) == 0 then "evidence unavailable (the jobs list carries no gated job)" elif ($d | length) == 1 and ($d[0].conclusion == "success") and all($g[]; .conclusion == "success") and all($gs[]; length > 0) and all($gs[]; all(.[]; .conclusion == "skipped")) then "duplicate-skipped" elif any($gs[]; any(.[]; .conclusion != "skipped")) then "executed" else "evidence unavailable (no gated job ran and the reuse could not be confirmed)" end' 2>/dev/null); [ -n "$v" ] || v="evidence unavailable (the jobs list could not be read)"; if [ "$c" = "success" ]; then case "$v" in executed) echo "executed: $c $sha $url" ;; duplicate-skipped) echo "duplicate-skipped: the gated steps were skipped; the tree already passed that workflow $sha $url" ;; *) echo "$v, so this run's gates are unverified $sha $url" ;; esac; else echo "$c $sha $url"; fi; fi
    ;;
  release)
vsha=$(gh api "repos/developerz-ai/wurk/commits?path=lib/wurk/version.rb&sha=main&per_page=1" 2>/dev/null | jq -r 'if type == "array" and length > 0 then .[0].sha else "" end' 2>/dev/null); if [ -z "$vsha" ]; then echo "verdict unknown: the main commit carrying Wurk::VERSION is unreadable, so no release run can be bound to it and no version read from it"; else v=$(gh api -H "Accept: application/vnd.github.raw" "repos/developerz-ai/wurk/contents/lib/wurk/version.rb?ref=$vsha" 2>/dev/null | grep -oE "[\"'][0-9][^\"']*[\"']" | head -1 | tr -d "\"'"); if [ -z "$v" ]; then echo "verdict unknown: lib/wurk/version.rb at $vsha is unreadable or carries no version, so the release run cannot be bound to a version"; else run=$(gh run list --workflow release.yml --branch main --event push --commit "$vsha" --limit 1 --json databaseId,headSha,conclusion,url 2>/dev/null); sha=$(jq -r 'if type == "array" and length > 0 then .[0].headSha else "" end' <<<"$run" 2>/dev/null); url=$(jq -r 'if type == "array" and length > 0 then .[0].url else "" end' <<<"$run" 2>/dev/null); c=$(jq -r 'if type == "array" and length > 0 then (.[0].conclusion | if . == null then "null" else . end) else "" end' <<<"$run" 2>/dev/null); if [ -z "$sha" ]; then echo "verdict unknown: no release.yml run for $vsha could be read"; elif [ "$sha" != "$vsha" ]; then echo "verdict unknown: the release.yml run reports headSha $sha, not the version's own sha $vsha, so it cannot be graded as this version's release"; elif [ "$c" = "null" ]; then echo "in flight $sha $url"; else dbid=$(jq -r 'if type == "array" and length > 0 then .[0].databaseId else "" end' <<<"$run" 2>/dev/null); jv=$(gh api "repos/developerz-ai/wurk/actions/runs/$dbid/jobs" 2>/dev/null | jq -r '[.jobs[]?] as $all | [$all[] | select(.name == "preflight")] as $p | [$all[] | select(.name == "release")] as $r | if ($all | length) == 0 then "unreadable" elif ($p | length) == 1 and ($p[0].conclusion == "success") and ($r | length) == 1 and ($r[0].conclusion == "skipped") and ([$all[] | select(.conclusion != "success" and .conclusion != "skipped")] | length == 0) then "noop" else "graded" end' 2>/dev/null); if [ -z "$jv" ] || [ "$jv" = "unreadable" ]; then echo "verdict unknown $sha $url"; elif [ "$jv" = "noop" ]; then echo "no-op $sha, preflight passed with finish=false: nothing was owed, that version is already released ($url)"; elif [ "$c" = "success" ]; then code=$(curl -sS --max-time 5 -o /dev/null -w '%{http_code}' "https://rubygems.org/api/v2/rubygems/wurk/versions/$v.json" 2>/dev/null); rc=$?; if [ "$rc" -ne 0 ] || [ "$code" = 000 ]; then echo "verdict unknown $sha $url: the RubyGems probe failed (curl rc=$rc, HTTP $code), so a green run cannot be called a publication"; elif [ "$code" = 200 ]; then echo "success $sha $url"; elif [ "$code" != 404 ]; then echo "verdict unknown $sha $url: HTTP $code is neither 200 nor 404, so the probe returned no readable verdict"; else echo "Unhealthy: green but empty publication: RubyGems serves no $v (HTTP 404) although the release run for $sha concluded success ($url), so the gem was never published"; fi; else echo "$c $sha $url"; fi; fi; fi; fi
    ;;
  rubygems)
vsha=$(gh api "repos/developerz-ai/wurk/commits?path=lib/wurk/version.rb&sha=main&per_page=1" 2>/dev/null | jq -r 'if type == "array" and length > 0 then .[0].sha else "" end' 2>/dev/null); if [ -z "$vsha" ]; then echo "verdict unknown: the main commit carrying Wurk::VERSION is unreadable, so there is no version of record to probe"; else v=$(gh api -H "Accept: application/vnd.github.raw" "repos/developerz-ai/wurk/contents/lib/wurk/version.rb?ref=$vsha" 2>/dev/null | grep -oE "[\"'][0-9][^\"']*[\"']" | head -1 | tr -d "\"'"); if [ -z "$v" ]; then echo "verdict unknown: lib/wurk/version.rb at $vsha is unreadable or carries no version, so there is no version of record to probe"; else code=$(curl -sS --max-time 5 -o /dev/null -w '%{http_code}' "https://rubygems.org/api/v2/rubygems/wurk/versions/$v.json"); rc=$?; if [ "$rc" -ne 0 ] || [ "$code" = 000 ]; then echo "verdict unknown: the probe failed (curl rc=$rc, HTTP $code), and no HTTP status is not evidence that $v is absent"; elif [ "$code" = 200 ]; then echo "success: RubyGems serves $v"; elif [ "$code" != 404 ]; then echo "verdict unknown: HTTP $code is neither 200 nor 404, so the probe returned no readable verdict"; else run=$(gh run list --workflow release.yml --branch main --event push --commit "$vsha" --limit 1 --json conclusion,headSha,url 2>/dev/null); rsha=$(jq -r 'if type == "array" and length > 0 then .[0].headSha else "" end' <<<"$run" 2>/dev/null); rcon=$(jq -r 'if type == "array" and length > 0 then (.[0].conclusion | if . == null then "null" else . end) else "" end' <<<"$run" 2>/dev/null); rurl=$(jq -r 'if type == "array" and length > 0 then .[0].url else "" end' <<<"$run" 2>/dev/null); if [ -z "$rsha" ]; then echo "verdict unknown: RubyGems serves no $v (HTTP 404), but release.yml's run for the version's own sha is unreadable, so an in-flight release cannot be told from a missing one"; elif [ "$rsha" != "$vsha" ]; then echo "verdict unknown: RubyGems serves no $v (HTTP 404), but the release.yml run reports headSha $rsha, not the version's own sha $vsha"; elif [ "$rcon" = "null" ]; then echo "in flight: RubyGems serves no $v yet, but release.yml's run for $vsha has not concluded ($rsha, $rurl)"; else echo "Unhealthy: RubyGems serves no $v (HTTP 404) and release.yml's run for $vsha has concluded ($rcon, $rurl), so nothing is propagating and the release did not publish $v"; fi; fi; fi; fi
    ;;
  github-release)
rel=$(gh release view --json author,assets 2>/dev/null); rc=$?; author=$(jq -r '.author.login // ""' <<<"$rel" 2>/dev/null); nassets=$(jq -r 'if (.assets | type) == "array" then (.assets | length) else "" end' <<<"$rel" 2>/dev/null); if [ "$rc" -ne 0 ] || [ -z "$author" ] || [ -z "$nassets" ]; then echo "verdict unknown: the Latest GitHub Release could not be read (gh release view rc=$rc), so a gem-less Latest Release cannot be told from a real one"; elif [ "$author" = "developerz-ai[bot]" ] || [ "$nassets" = "0" ]; then echo "Unhealthy: gem-less Latest Release: the Latest GitHub Release was cut by $author with $nassets assets, so the Latest badge lies about the published version"; else echo "success: the Latest GitHub Release carries the gem ($nassets assets, author $author)"; fi
    ;;
  deploy)
run=$(gh run list --workflow deploy-demo.yml --limit 1 --json databaseId,headSha,conclusion,url 2>/dev/null); rc=$?; if [ "$rc" -ne 0 ] || [ -z "$run" ] || ! printf '%s' "$run" | jq -e 'type == "array"' >/dev/null 2>&1; then echo "verdict unknown deploy-demo.yml: the run list is not readable (gh run list failed or returned a non-array)"; elif [ "$(printf '%s' "$run" | jq -r 'length')" = "0" ]; then echo "no run: deploy-demo.yml has no matching run"; else run=$(printf '%s' "$run" | jq -c '.[0]'); sha=$(jq -r .headSha <<<"$run"); c=$(jq -r .conclusion <<<"$run"); url=$(jq -r .url <<<"$run"); repo=$(gh repo view --json nameWithOwner -q .nameWithOwner); jobs=$(gh api "repos/$repo/actions/runs/$(jq -r .databaseId <<<"$run")/jobs" 2>/dev/null); if [ -z "$jobs" ] || [ "$jobs" = "null" ]; then v=unreadable; else job_id=$(printf '%s' "$jobs" | jq -r '.jobs[]? | select(.name == "build") | .id' 2>/dev/null | head -1); log=$(gh run view "$(jq -r .databaseId <<<"$run")" --job "$job_id" --log 2>/dev/null); if [ -z "$log" ]; then v=unreadable; else v=$(printf '%s' "$log" | awk -F'\t' '$2 == "resolve built commit"' | grep -oE '(^|[^-0-9A-Za-z_])sha-[0-9a-f]{7}([^-0-9A-Za-z_]|$)' | head -1 | grep -oE 'sha-[0-9a-f]{7}'); if [ -z "$v" ]; then v=unresolved; fi; fi; fi; if [ "$v" = unreadable ]; then echo "verdict unknown $sha $url"; elif [ "$v" = unresolved ]; then echo "Unhealthy: deploy-demo built no sha-<7> image tag at $sha, so Image Updater has no candidate and the demo is frozen on its current digest ($url)"; else echo "$c $sha $url tagged $v"; fi; fi
    ;;
  served-version)
expected=$(grep -oE "[\"'][0-9][^\"']*[\"']" lib/wurk/version.rb | head -1 | tr -d "\"'"); out=$(curl -sS --max-time 5 -w '\n%{http_code}' "https://wurk.demo.developerz.ai/wurk/api/meta" 2>/dev/null); rc=$?; code=$(printf '%s' "$out" | awk 'BEGIN{RS="\n"} END{print $0}'); body=$(printf '%s' "$out" | awk 'BEGIN{RS="\n"} {if (NR>1) print prev; prev=$0}'); if [ "$rc" -ne 0 ] || [ -z "$code" ] || [ "$code" = 000 ]; then echo "verdict unknown: the demo version probe failed (curl rc=$rc, HTTP ${code:-none}), so the served version cannot be read"; elif [ "$code" != 200 ]; then echo "verdict unknown: the demo version probe returned HTTP $code, so the served version cannot be read"; else served=$(printf '%s' "$body" | jq -rse 'if length == 1 and (.[0] | type == "object") then (.[0].version // empty) else empty end' 2>/dev/null); jq_rc=$?; if [ "$jq_rc" -ne 0 ] || [ -z "$served" ]; then echo "verdict unknown: the demo version probe returned no usable version (HTTP body was not a single JSON object with a version key)"; elif [ "$served" = "$expected" ]; then echo "success: the demo serves $expected"; else echo "Unhealthy: the demo serves $served but the checkout expects $expected"; fi; fi
    ;;
  lanes)
for wf in topology.yml ecosystem.yml; do run=$(gh run list --workflow $wf --branch main --event push --limit 1 --json databaseId,headSha,conclusion,url 2>/dev/null); rc=$?; if [ "$rc" -ne 0 ] || [ -z "$run" ] || ! printf '%s' "$run" | jq -e 'type == "array"' >/dev/null 2>&1; then echo "verdict unknown $wf: the run list is not readable (gh run list failed or returned a non-array)"; elif [ "$(printf '%s' "$run" | jq -r 'length')" = "0" ]; then echo "no run: $wf has no matching run"; else run=$(printf '%s' "$run" | jq -c '.[0]'); sha=$(jq -r .headSha <<<"$run"); url=$(jq -r .url <<<"$run"); c=$(jq -r .conclusion <<<"$run"); dbid=$(jq -r .databaseId <<<"$run"); v=$(gh api "repos/$(gh repo view --json nameWithOwner -q .nameWithOwner)/actions/runs/$dbid/jobs" | jq -r 'def gate_steps: [(.steps // [])[] | select(.name != "Set up job" and .name != "Complete job")]; [.jobs[]?] as $all | [$all[] | select(.name != "detect changed paths" and .name != "sidekiq release watcher")] as $g | [$all[] | select(.name == "detect changed paths")] as $d | ($g | map(gate_steps)) as $gs | if ($all | length) == 0 then "evidence unavailable (the jobs list could not be read)" elif ($g | length) == 0 then "evidence unavailable (the jobs list carries no gated job)" elif ($d | length) == 1 and ($d[0].conclusion == "success") and all($g[]; .conclusion == "success") and all($gs[]; length > 0) and all($gs[]; all(.[]; .conclusion == "skipped")) then "duplicate-skipped" elif any($gs[]; any(.[]; .conclusion != "skipped")) then "executed" else "evidence unavailable (no gated job ran and the reuse could not be confirmed)" end' 2>/dev/null); [ -n "$v" ] || v="evidence unavailable (the jobs list could not be read)"; if [ "$c" = "success" ]; then case "$v" in executed) echo "$wf executed: $c $sha $url" ;; duplicate-skipped) echo "$wf duplicate-skipped: the gated steps were skipped; the tree already passed that workflow $sha $url" ;; *) echo "$wf $v, so this lane's gates are unverified $sha $url" ;; esac; else echo "$wf $c $sha $url"; fi; fi; done
    ;;
  dependabot)
prs=$(gh pr list --state open --app dependabot --json number,title,createdAt,headRefName,updatedAt,statusCheckRollup,headRefOid 2>/dev/null); if [ -z "$prs" ] || ! printf '%s' "$prs" | jq -e 'type == "array"' >/dev/null 2>&1; then echo "verdict unknown dependabot: the open PR list is not readable (gh pr list failed or returned a non-array)"; exit 0; fi; now=$(date -u +%s); repo=$(gh repo view --json nameWithOwner -q .nameWithOwner); pinsite() { gh api -H "Accept: application/vnd.github.raw" "repos/$repo/contents/$1?ref=$2" 2>/dev/null; }; pins='{}'; cands=$(printf '%s' "$prs" | jq -r --argjson now "$now" 'def eco: if test(" group with .* updates$") or test("^Bump actions/") or test("^Bump github-actions/") then "github-actions" elif test(" in /frontend") then "bun" elif test(" in /Dockerfile") or test("^Bump [^ ]+/[^ ]+ from") then "docker" else "bundler" end; def branch_eco: if test("^dependabot/bundler/") then "bundler" elif test("^dependabot/bun/") then "bun" elif test("^dependabot/github_actions/") then "github-actions" elif test("^dependabot/docker/") then "docker" else null end; def budget: {"github-actions":37,"docker":37,"bundler":28,"bun":14}; def state: [.statusCheckRollup[]? | select(type=="object") | if has("state") then .state elif (.conclusion|type)=="string" then .conclusion else "PENDING" end] as $c | if any($c[]; test("^(FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STALE|STARTUP_FAILURE)$")) then "FAILURE" elif any($c[]; test("^(PENDING|EXPECTED)$")) then "PENDING" else "SUCCESS" end; .[] | . as $p | ($now - ($p.createdAt|fromdateiso8601)) as $sec | ($sec/86400|floor) as $age | ((($p.headRefName // "")|branch_eco) // (($p.title // "")|eco)) as $e | ($p|state) as $s | ($p.title // "") as $t | select(($age>budget[$e]) and ($s=="FAILURE") and $e=="docker" and (($p.headRefOid // "") != "")) | [($p.number|tostring), ($p.headRefOid // ""), (if (($t|test("^Bump [^ ]+/[^ ]+ from")) or ($t|test(" group with .* updates$"))) then "1" else "0" end)] | @tsv'); if [ -n "$cands" ]; then while IFS=$'\t' read -r n sha iscand; do if [ -z "$n" ]; then continue; fi; disc=""; dl=""; sib=""; names="[]"; runraw=$(gh run list --workflow test.yml --commit "$sha" --json databaseId,conclusion 2>/dev/null); runrc=$?; if [ "$runrc" -ne 0 ] || ! printf '%s' "$runraw" | jq -e 'type == "array"' >/dev/null 2>&1; then disc=fail; else run=$(printf '%s' "$runraw" | jq -r '[.[] | select(.conclusion == "failure")][0].databaseId // empty' 2>/dev/null); if [ -z "$run" ]; then disc=norun; else jobs_json=$(gh api "repos/$repo/actions/runs/$run/jobs" 2>/dev/null); job=$(printf '%s' "$jobs_json" | jq -r '[.jobs[]? | select(.name == "test + coverage (latest ruby/rails)")][0].id // empty' 2>/dev/null); if [ -z "$job" ]; then disc=unreadable; else dl=$(gh run view "$run" --job "$job" --log-failed 2>/dev/null); dlrc=$?; sib=$(printf '%s' "$jobs_json" | jq -r 'if (.jobs? | type) != "array" then "unknown" elif any(.jobs[]?; ((.name // "") != "test + coverage (latest ruby/rails)") and ((.conclusion // "") | test("^(failure|timed_out|cancelled|action_required|startup_failure|stale)$"))) then "red" else "clean" end' 2>/dev/null); names=$(printf '%s' "$jobs_json" | jq -c '[.jobs[]? | select((.conclusion // "") | test("^(failure|timed_out|cancelled|action_required|startup_failure|stale)$")) | (.name // empty)]' 2>/dev/null); [ -n "$sib" ] || sib="unknown"; [ -n "$names" ] || names="[]"; if [ "$dlrc" -ne 0 ] || [ -z "$dl" ]; then disc=unreadable; else disc=ok; fi; fi; fi; fi; ps=""; if [ "$disc" = "norun" ] && [ "$iscand" = "1" ]; then df=$(pinsite Dockerfile "$sha"); dfrc=$?; mt=$(pinsite mise.toml "$sha"); mtrc=$?; dd=$(pinsite docs/deployment.md "$sha"); ddrc=$?; wy=$(pinsite .github/workflows/test.yml "$sha"); wyrc=$?; wl=$(pinsite .github/workflows/release.yml "$sha"); wlrc=$?; if [ "$dfrc" -ne 0 ] || [ "$mtrc" -ne 0 ] || [ "$ddrc" -ne 0 ] || [ "$wyrc" -ne 0 ] || [ "$wlrc" -ne 0 ] || [ -z "$df" ] || [ -z "$mt" ] || [ -z "$dd" ] || [ -z "$wy" ] || [ -z "$wl" ]; then ps=unreadable; else dv=$(printf '%s\n' "$df" | sed -n 's/^FROM oven\/bun:\([0-9][0-9.]*\).*$/\1/p' | head -1); mv=$(printf '%s\n' "$mt" | sed -n 's/^bun[[:space:]]*=[[:space:]]*"\([0-9][0-9.]*\)".*$/\1/p' | head -1); dc=$(printf '%s\n' "$dd" | sed -n 's/^FROM oven\/bun:\([0-9][0-9.]*\).*$/\1/p' | head -1); wv=$(printf '%s\n%s\n' "$wy" "$wl" | grep 'bun-version:' | grep -oE '[0-9]+(\.[0-9]+)*' | sort -u); if [ -z "$dv" ] || [ -z "$mv" ] || [ -z "$dc" ] || [ -z "$wv" ]; then ps=mismatch; elif [ "$(printf '%s\n%s\n%s\n%s\n' "$dv" "$mv" "$dc" "$wv" | sort -u | wc -l)" -eq 1 ]; then ps=agree; else ps=mismatch; fi; fi; fi; pins=$(printf '%s' "$pins" | jq -c --arg n "$n" --arg disc "$disc" --arg ps "$ps" --arg log "$dl" --arg sib "$sib" --argjson names "$names" '. + {($n): {disc:$disc, ps:$ps, log:$log, sib:$sib, names:$names}}'); done <<< "$cands"; fi; printf '%s' "$prs" | jq -r --argjson now "$now" --argjson pins "$pins" 'def eco: if test(" group with .* updates$") or test("^Bump actions/") or test("^Bump github-actions/") then "github-actions" elif test(" in /frontend") then "bun" elif test(" in /Dockerfile") or test("^Bump [^ ]+/[^ ]+ from") then "docker" else "bundler" end; def branch_eco: if test("^dependabot/bundler/") then "bundler" elif test("^dependabot/bun/") then "bun" elif test("^dependabot/github_actions/") then "github-actions" elif test("^dependabot/docker/") then "docker" else null end; def budget: {"github-actions":37,"docker":37,"bundler":28,"bun":14}; def red: test("^(FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STALE|STARTUP_FAILURE)$"); def state: [.statusCheckRollup[]? | select(type=="object") | if has("state") then .state elif (.conclusion|type)=="string" then .conclusion else "PENDING" end] as $c | if any($c[]; test("^(FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STALE|STARTUP_FAILURE)$")) then "FAILURE" elif any($c[]; test("^(PENDING|EXPECTED)$")) then "PENDING" else "SUCCESS" end; def rednames: [.statusCheckRollup[]? | select(type=="object") | ((if has("state") then .state elif (.conclusion|type)=="string" then .conclusion else "PENDING" end) // "") as $st | select($st | red) | ((if has("name") then .name elif has("context") then .context else "unknown" end) // "unknown")]; if length == 0 then "dependabot: 0 open PRs" else (map(. as $p | ($now - ($p.createdAt|fromdateiso8601)) as $sec | ($sec/86400|floor) as $age | ((($p.headRefName // "") | branch_eco) // (($p.title // "") | eco)) as $e | ($p|state) as $s | ($p.title // "") as $t | (($age>budget[$e]) and ($s=="FAILURE")) as $redpast | ($redpast and $e=="docker" and (($t|test("^Bump [^ ]+/[^ ]+ from")) or ($t|test(" group with .* updates$")))) as $cand | ($pins[($p.number|tostring)] // {disc:"none",ps:"",log:"",sib:"unknown",names:[]}) as $d | ([$d.log | match("[A-Za-z0-9_/.-]+_test\\.rb"; "g") | .string] | unique) as $files | ($p|rednames) as $rn | {n:$p.number,age:$age,b:budget[$e],e:$e,s:$s,br:($p.headRefName // "unknown"),sha:($p.headRefOid // "unknown"),up:($p.updatedAt // "unknown"),v:(if $cand then (if ($d.disc=="fail") or ($d.disc=="unreadable") then "discunknown" elif $d.disc=="ok" then (if ($files|length) == 0 then "nofile" elif (($files|all(. == "test/unit/toolchain_pins_test.rb")) and $d.sib=="clean" and ($rn|all(. as $x | ($d.names|index($x)) != null))) then "awaiting" else "stuck" end) elif $d.ps=="mismatch" then "waiting" elif $d.ps=="agree" then "stuck" else "pinsunknown" end) elif $redpast then "stuck" else "none" end)}) as $prs | (["bundler","bun","github-actions","docker"] | map(. as $k | [$prs[] | select(.e==$k)]) | map(select(length > 0)) | map({e: .[0].e, n: length, s: (if any(.[]; .s=="FAILURE") then "FAILURE" elif any(.[]; .s=="PENDING") then "PENDING" else "SUCCESS" end)})) as $groups | ("dependabot: " + ($prs|length|tostring) + " open PRs (" + ($groups | map(.e + " " + (.n|tostring) + " " + .s) | join(", ")) + ")"), ($prs[] | "#" + (.n|tostring) + " " + .e + " " + .br + " " + .sha + " " + .up + " " + .s), ($prs[] | select(.v=="pinsunknown") | "verdict unknown dependabot: the bun pins at PR #" + (.n|tostring) + " (head " + .sha + ") are not readable (a pin-site contents read failed), so waiting-on-us cannot be verified and no ask is filed"), ($prs[] | select(.v=="discunknown") | . as $q | "verdict unknown dependabot #\($q.n): the docker pin discriminator is unreadable, so the PR is neither stuck nor cleared"), ($prs[] | select(.v=="nofile") | . as $q | "verdict unknown dependabot #\($q.n): the docker pin discriminator names no failing test, so the PR is neither stuck nor cleared"), ($prs[] | select(.v=="awaiting") | . as $q | "Dependabot #\($q.n) is awaiting matching pin edits"), ($prs[] | select(.v=="waiting") | "Unhealthy: Docker bump #" + (.n|tostring) + " is waiting on us: matching bun pins — push the pin edits to the branch (age " + (.age|tostring) + "d > " + (.b|tostring) + "d budget for " + .e + ")"), ($prs[] | select(.v=="stuck") | "Unhealthy: Dependabot is stuck on #" + (.n|tostring) + " (age " + (.age|tostring) + "d > " + (.b|tostring) + "d budget for " + .e + ")")) end'
    ;;
  *) echo "Expected one health signal selector" >&2; exit 2 ;;
esac
