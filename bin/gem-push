#!/usr/bin/env bash
# Push the built gem to rubygems.org. Requires `bin/gem-login` first.
# MFA is enforced (rubygems_mfa_required), so this prompts for an OTP at push
# time — pass one non-interactively with: bin/gem-push 123456
set -euo pipefail
cd "$(dirname "$0")/.."

version="$(ruby -Ilib -e 'require "wurk/version"; print Wurk::VERSION')"
gemfile="pkg/wurk-${version}.gem"

if [ ! -f "$gemfile" ]; then
  echo "✗ $gemfile not found — run bin/gem-build first." >&2
  exit 1
fi

# Same gate CI runs (`release.yml`'s "release gate" step). Without it, an out-
# of-band local push could ship a .gem that never passed `release:check` and
# the lane that exists to forbid it would have leaked right past itself.
# `set -euo pipefail` above means a failing gate aborts before `gem push`.
echo "==> Running release:check (the same gate CI runs before publishing)"
bundle exec rake release:check

echo "==> Pushing ${gemfile} to rubygems.org"
if [ "${1:-}" != "" ]; then
  gem push "$gemfile" --otp "$1"
else
  gem push "$gemfile"
fi
echo "==> pushed — https://rubygems.org/gems/wurk/versions/${version}"
