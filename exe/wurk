#!/usr/bin/env ruby
# frozen_string_literal: true

# Standalone runner. Does NOT load the Rails engine.
# Usage: `exe/wurk -C config/wurk.yml`     — worker: one process, thread pool
#        `exe/wurk api --port 7433`        — machine HTTP API, runs no jobs
#        `exe/wurk preflight` / `verify`   — read-only cutover checks, run no jobs
#        `exe/wurk boot-check -r .`        — boot the app as wurkswarm would, then exit (CI)

$stdout.sync = true
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'wurk'

if %w[preflight verify].include?(ARGV.first)
  require 'wurk/preflight/command'
  exit Wurk::Preflight::Command.run(ARGV.dup)
end

begin
  cli = Wurk::CLI.instance
  cli.parse
  case cli.command
  when 'api'        then cli.run_api
  when 'boot-check' then exit(cli.run_boot_check)
  else                   cli.run
  end
rescue StandardError => e
  raise e if $DEBUG

  Wurk::CLI.report_failure('wurk', e)
  exit 1
end
