{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bin/check:*)",
      "Bash(bin/rake test:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": ["Read(./.env*)", "Read(./**/*.key)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v ruby >/dev/null || exit 0; cd \"${CLAUDE_PROJECT_DIR:?}\" && ruby --disable-gems .claude/hooks/guard_bash.rb",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v ruby >/dev/null || exit 0; cd \"${CLAUDE_PROJECT_DIR:?}\" && ruby --disable-gems .claude/hooks/post_edit.rb",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
